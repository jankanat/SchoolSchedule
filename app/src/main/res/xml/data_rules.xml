<?xml version="1.0" encoding="utf-8"?>
<!-- Автобэкап Google и перенос на новый телефон (Android 12+) -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="state.json" />
        <include domain="file" path="icons/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="state.json" />
        <include domain="file" path="icons/" />
    </device-transfer>
</data-extraction-rules>
